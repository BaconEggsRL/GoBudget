[gd_scene load_steps=3 format=3 uid="uid://gpbyn2qxvnbu"]

[ext_resource type="Script" uid="uid://c0rxf3514q2tm" path="res://scenes/data/category.gd" id="1_6mash"]
[ext_resource type="Theme" uid="uid://d26p00jqqx2n4" path="res://btn_theme.tres" id="2_jvv07"]

[node name="Category" type="VBoxContainer" node_paths=PackedStringArray("subcats", "order_label", "category_name", "budget")]
mouse_filter = 0
script = ExtResource("1_6mash")
subcats = NodePath("subcats")
order_label = NodePath("cat/order_label")
category_name = NodePath("cat/category_name")
budget = NodePath("cat/budget")

[node name="cat" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="order_label" type="Label" parent="cat"]
layout_mode = 2
text = "1) "

[node name="category_name" type="LineEdit" parent="cat"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Category"

[node name="budget" type="SpinBox" parent="cat"]
layout_mode = 2
max_value = 10000.0
rounded = true
allow_greater = true
alignment = 2
prefix = "$"
custom_arrow_step = 1.0

[node name="delete_category" type="Button" parent="cat"]
layout_mode = 2
text = "x"

[node name="subcats" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Add" type="HBoxContainer" parent="subcats"]
layout_mode = 2

[node name="Label2" type="Label" parent="subcats/Add"]
layout_mode = 2
text = "     "

[node name="Label3" type="Label" parent="subcats/Add"]
layout_mode = 2
text = "     "

[node name="create_subcategory" type="Button" parent="subcats/Add"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Add New Subcategory"
theme = ExtResource("2_jvv07")
theme_type_variation = &"FocusButton"
text = "+"
alignment = 2
icon_alignment = 2

[connection signal="text_changed" from="cat/category_name" to="." method="_on_category_name_text_changed"]
[connection signal="pressed" from="cat/delete_category" to="." method="_on_delete_category_pressed"]
[connection signal="pressed" from="subcats/Add/create_subcategory" to="." method="_on_create_subcategory_pressed"]
